  "validators": {
    "Assay.detect_target_repo_comments": {
      "function_name": "detect_target_repo_comments",
      "model": "Assay",
      "fields": [
        "comments"
      ],
      "mode": "after",
      "docstring": null,
      "module": "mars_lib.models.isa_json",
      "source": "    @field_validator(\"comments\")\n    def detect_target_repo_comments(cls, v: list[Comment]) -> list[Comment] | None:\n        target_repo_comments = [\n            comment for comment in v if comment.name == TARGET_REPO_KEY\n        ]\n        if len(target_repo_comments) == 0:\n            raise ValueError(f\"'{TARGET_REPO_KEY}' comment is missing\")\n        elif len(target_repo_comments) > 1:\n            raise ValueError(f\"Multiple '{TARGET_REPO_KEY}' comments found\")\n        else:\n            if target_repo_comments[0].value in [\n                item.value for item in TargetRepository\n            ]:\n                return v\n            else:\n                raise ValueError(\n                    f\"Invalid '{TARGET_REPO_KEY}' value: '{target_repo_comments[0].value}'\"\n                )\n"
    },
    "Assay.validate_filename": {
      "function_name": "validate_filename",
      "model": "Assay",
      "fields": [
        "filename"
      ],
      "mode": "after",
      "docstring": null,
      "module": "mars_lib.models.isa_json",
      "source": "    @field_validator(\"filename\")\n    def validate_filename(cls, v: str) -> str:\n        return _validate_filename(v, \"a\", \"assay\")\n"
    },
    "Investigation.validate_filename": {
      "function_name": "validate_filename",
      "model": "Investigation",
      "fields": [
        "filename"
      ],
      "mode": "after",
      "docstring": null,
      "module": "mars_lib.models.isa_json",
      "source": "    @field_validator(\"filename\")\n    def validate_filename(cls, v: str) -> str:\n        return _validate_filename(v, \"i\", \"investigation\")\n"
    },
    "Process.empty_link_is_no_link": {
      "function_name": "empty_link_is_no_link",
      "model": "Process",
      "fields": [
        "previousProcess",
        "nextProcess"
      ],
      "mode": "before",
      "docstring": null,
      "module": "mars_lib.models.isa_json",
      "source": "    @field_validator(\"previousProcess\", \"nextProcess\", mode=\"before\")\n    def empty_link_is_no_link(cls, v: object) -> object:\n        # The first/last process of a sequence has no previous/next process,\n        # which is written as an empty object ('{}').\n        return None if v == {} else v\n"
    },
    "Study.require_organism_category": {
      "function_name": "require_organism_category",
      "model": "Study",
      "fields": [
        "characteristicCategories"
      ],
      "mode": "after",
      "docstring": null,
      "module": "mars_lib.models.isa_json",
      "source": "    @field_validator(\"characteristicCategories\")\n    def require_organism_category(\n        cls, v: list[MaterialAttribute]\n    ) -> list[MaterialAttribute]:\n        # Special rule: the 'organism' characteristic category is mandatory\n        # (required for BioSamples submissions).\n        if not any(\n            category.characteristicType is not None\n            and isinstance(category.characteristicType.annotationValue, str)\n            and category.characteristicType.annotationValue.lower() == \"organism\"\n            for category in v\n        ):\n            raise ValueError(\"'organism' characteristic category is missing\")\n        return v\n"
    },
    "Study.validate_filename": {
      "function_name": "validate_filename",
      "model": "Study",
      "fields": [
        "filename"
      ],
      "mode": "after",
      "docstring": null,
      "module": "mars_lib.models.isa_json",
      "source": "    @field_validator(\"filename\")\n    def validate_filename(cls, v: str) -> str:\n        return _validate_filename(v, \"s\", \"study\")\n"
    }
  }
