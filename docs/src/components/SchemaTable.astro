---
import TableFrame from "./TableFrame.astro";
import { badge, codeCell, link, nameCell, row } from "./tableStyles";

type JsonSchema = {
  type?: string;
  anyOf?: JsonSchema[];
  items?: JsonSchema;
  $ref?: string;
  properties?: Record<string, JsonSchema>;
  required?: string[];
};

type TypePart = { text: string; ref?: string };

const { title, schema } = Astro.props as { title: string; schema: JsonSchema };

// Renders a JSON-schema type as readable text; a $ref links to that model's section on this page.
function describe(property: JsonSchema): TypePart[] {
  if (property.$ref) {
    const name = property.$ref.split("/").pop() ?? property.$ref;
    return [{ text: name, ref: `#${name}` }];
  }
  if (property.anyOf) {
    return property.anyOf.flatMap((option, index) =>
      index === 0 ? describe(option) : [{ text: " | " }, ...describe(option)],
    );
  }
  if (property.type === "array") {
    return [{ text: "array of " }, ...describe(property.items ?? {})];
  }
  return [{ text: property.type ?? "any" }];
}

const required = new Set(schema.required ?? []);
const rows = Object.entries(schema.properties ?? {}).map(([name, property]) => ({
  name,
  type: describe(property),
  isRequired: required.has(name),
}));
---

<section class="my-8">
  <h3 id={title}>{title}</h3>
  <TableFrame columns={["Field", "Type", "Required"]} widths={["w-[16%]", "w-[18%]", "w-[10%]"]}>
    {rows.map(({ name, type, isRequired }) => (
      <tr class={row}>
        <th scope="row" class={nameCell}>{name}</th>
        <td class={codeCell}>
          {type.map((part) =>
            part.ref ? <a href={part.ref} class={link}>{part.text}</a> : part.text,
          )}
        </td>
        <td class="px-4 py-3 text-left align-top">
          <span class={badge(isRequired)}>{isRequired ? "Yes" : "No"}</span>
        </td>
      </tr>
    ))}
  </TableFrame>
</section>
